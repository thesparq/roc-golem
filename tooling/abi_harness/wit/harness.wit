package roc-golem:abi-harness@0.1.0;

/// World used to instantiate a built roc-golem component outside Golem.
///
/// A linked component only imports the interfaces its own code actually uses
/// (the linker drops the rest), so this world mirrors what the examples reach
/// today: the agent interface plus the effects they call. Extend it alongside
/// the host's effect implementations.
world harness-world {
    import golem:core/types@1.5.0;
    import wasi:clocks/monotonic-clock@0.2.3;
    import golem:agent/common@1.5.0;
    import golem:websocket/client@1.5.0;
    import wasi:logging/logging;

    export golem:agent/guest@1.5.0;
}
