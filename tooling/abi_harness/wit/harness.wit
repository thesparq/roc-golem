package roc-golem:abi-harness@0.1.0;

/// World used to instantiate a built roc-golem component outside Golem.
///
/// The world is self-contained: every interface a component imports — agent
/// types, the clocks, wasi:io, wasi:http, the WebSocket client and
/// wasi:logging — is implemented by this harness's own stubs (see `src/stubs.rs`),
/// so no wasmtime-wasi linker is involved (wasmtime's own `wasi:http` tracks a
/// newer WASI version than Golem pins). Keep this world in sync with the
/// imports of the components under test.
world harness-world {
    import golem:core/types@2.0.0;
    // The oplog/execution-control surface the examples reach for (`trap`,
    // `resolve-component-id`, `oplog-commit`, …) is synchronous, so the stubs
    // here can drive it and record what the component asked for.
    import golem:api/host@1.5.0;
    import golem:api/retry@1.5.0;
    import golem:quota/types@1.5.0;
    import golem:agent/common@2.0.0;
    import golem:agent/host@2.0.0;
    import golem:tool/common@0.1.0;
    import golem:tool/streams@0.1.0;
    import golem:websocket/client@1.5.0;
    // The two shared stores (`wasi:keyvalue`, `wasi:blobstore`) are synchronous
    // too, so the stubs keep a small store of their own and record every call:
    // a round trip through the component has to come back out changed.
    import wasi:blobstore/blobstore;
    import wasi:blobstore/container;
    import wasi:blobstore/types;
    import wasi:clocks/types@0.3.0;
    import wasi:clocks/monotonic-clock@0.2.6;
    import wasi:clocks/wall-clock@0.2.6;
    import wasi:io/error@0.2.6;
    import wasi:io/streams@0.2.6;
    import wasi:io/poll@0.2.6;
    import wasi:http/types@0.2.6;
    import wasi:http/outgoing-handler@0.2.6;
    import wasi:keyvalue/eventual@0.1.0;
    import wasi:keyvalue/types@0.1.0;
    import wasi:keyvalue/wasi-keyvalue-error@0.1.0;
    import wasi:logging/logging;

    export golem:agent/guest@2.0.0;
}
